{
  "name": "monosub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "export PATH=\"$HOME/.cargo/bin:$PATH\" && bunx tauri dev",
    "dev:servers": "vite",
    "build": "tsc -b && vite build && export PATH=\"$HOME/.cargo/bin:$PATH\" && bunx tauri build",
    "build:frontend": "tsc -b && vite build",
    "build:dmg": "./scripts/build-dmg.sh build",
    "build:dmg-only": "./scripts/build-dmg.sh dmg",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "clean": "./scripts/build-dmg.sh clean"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
