    "@tauri-apps/api": "^2.12",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
