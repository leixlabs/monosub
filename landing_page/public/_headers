# Set correct MIME types for JavaScript modules
/assets/*.js
  Content-Type: application/javascript; charset=utf-8

/*.js
  Content-Type: application/javascript; charset=utf-8

# Cache static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Screenshots and the social card keep stable file names (they are re-captured,
# not rebuilt), so they are cached for a day rather than immutably — an immutable
# cache would keep serving a stale screenshot after the app's UI changes.
/screenshots/*
  Cache-Control: public, max-age=86400

/og-image.jpg
  Cache-Control: public, max-age=86400

/icon.png
  Cache-Control: public, max-age=86400
