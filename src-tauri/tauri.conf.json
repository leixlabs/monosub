{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonoSub",
  "version": "0.1.0",
  "identifier": "com.monosub.client",
  "build": {
    "beforeDevCommand": "bun run dev:servers",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MonoSub",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/*": "./"
    },
    "externalBin": [
      "resources/bin/ffmpeg",
      "resources/bin/ffprobe",
      "resources/bin/monosub-engine"
    ]
  }
}
