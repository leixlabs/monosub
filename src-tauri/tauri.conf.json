{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonoSub",
  "version": "0.1.0",
  "identifier": "com.monosub.app",
  "build": {
    "beforeDevCommand": "bun run dev:servers",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MonoSub",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
