# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
core-engine/venv/
core-engine/env/
core-engine/.venv/
*.egg-info/
dist/
!scripts/build/
core-engine/dist/
core-engine/build/
core-engine/*.spec

# uv
.python-version

# Models
core-engine/models/*
!core-engine/models/.gitkeep

# Tauri
src-tauri/target/
# Bundled binaries and models are fetched by the resource scripts
# (fetch-audiocpp.sh for the audio.cpp CLI + Silero VAD, fetch-llamacpp.sh for
# llama-server and its dylibs). The pattern covers those artifacts and nothing
# else, so the flat `lib*.dylib` files in bin/ need no extra rule.
src-tauri/resources/*
# The model catalogue is source, not a fetched artifact
!src-tauri/resources/models.json
# License texts are source: Apache-2.0 requires shipping audio.cpp's LICENSE,
# so these must be committed rather than fetched (P2-6).
!src-tauri/resources/licenses/
!src-tauri/resources/licenses/**

# Temporary files
*.wav
*.mp3

# Windows MSIX staging (scripts/windows/build-msix.sh) and its dev cert.
# Root-anchored so the tracked scripts/build/ directory is not affected.
/build/
*.pfx

# Scratch downloads for the Windows packaging work; never committed.
/.winbuild/

# Phase 0 PoC scratch (scripts are in scripts/poc/, everything else is local)
poc/
/tmp/

.trae

.claude/skills/ui-ux-pro-max

/models

.pi
